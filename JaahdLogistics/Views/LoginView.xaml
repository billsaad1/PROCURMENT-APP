<UserControl x:Class="JaahdLogistics.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border BorderBrush="{StaticResource LightGrayBrush}" BorderThickness="1" Padding="40" CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Gray" Opacity="0.2" ShadowDepth="5"/>
        </Border.Effect>
        <StackPanel Width="300">
            <TextBlock Text="{DynamicResource Login}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SecondaryBlueBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            
            <TextBlock Text="{DynamicResource Username}" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,15"/>
            
            <TextBlock Text="{DynamicResource Password}" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PassBox" Height="35" Margin="0,0,0,30"/>
            
            <Button Content="{DynamicResource Login}" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=PassBox}"
                    Height="40" FontSize="16" FontWeight="Bold"/>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
