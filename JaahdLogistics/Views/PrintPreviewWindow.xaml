<Window x:Class="JaahdLogistics.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview" Height="800" Width="900" WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding Data.CurrentFlowDirection, Source={StaticResource Proxy}}">
    <Grid Background="#525659">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#323639" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Print" Click="Print_Click" Width="80" Margin="5"/>
                <TextBlock Text="Zoom:" Foreground="White" VerticalAlignment="Center" Margin="20,0,5,0"/>
                <Slider x:Name="ZoomSlider" Width="150" Minimum="0.5" Maximum="2.0" Value="1.0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ElementName=ZoomSlider, Path=Value, StringFormat={}{0:P0}}" Foreground="White" VerticalAlignment="Center" Margin="5,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border x:Name="PrintBorder" Background="White" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top" 
                    BorderBrush="Black" BorderThickness="1">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ElementName=ZoomSlider, Path=Value}" ScaleY="{Binding ElementName=ZoomSlider, Path=Value}"/>
                </Border.LayoutTransform>
                <!-- A4 Paper size in 96 DPI: 794 x 1123 -->
                <Control x:Name="PreviewContent" Width="794" Height="1123" 
                         Template="{StaticResource PrintFormTemplate}"/>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
