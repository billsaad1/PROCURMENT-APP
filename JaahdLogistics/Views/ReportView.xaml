<UserControl x:Class="JaahdLogistics.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JaahdLogistics.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <TextBlock Text="Logistics Reports &amp; Analytics" FontSize="26" FontWeight="Bold" Foreground="#1B4F72"/>
            <Button Content="Refresh Reports" Command="{Binding LoadReportsCommand}" HorizontalAlignment="Right" Padding="15,7" Background="#1B4F72"/>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="White">
            <TabItem Header="Project Spending">
                <Grid Margin="15">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="SpendingGrid" ItemsSource="{Binding SpendingReport}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Total Spent (USD)" Binding="{Binding TotalSpent, StringFormat=N2}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Print Spending Report" Command="{Binding PrintReportCommand}" CommandParameter="{Binding ElementName=SpendingGrid}"
                            HorizontalAlignment="Right" Margin="0,15,0,0" Padding="15,10" Background="#27AE60"/>
                </Grid>
            </TabItem>

            <TabItem Header="Inventory Status">
                <Grid Margin="15">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding InventoryReport}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Description" Binding="{Binding ItemDescription}" Width="*"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="200"/>
                            <DataGridTextColumn Header="Current Quantity" Binding="{Binding CurrentQuantity}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Print Inventory Report" Command="{Binding PrintReportCommand}" CommandParameter="{Binding ElementName=InventoryGrid}"
                            HorizontalAlignment="Right" Margin="0,15,0,0" Padding="15,10" Background="#27AE60"/>
                </Grid>
            </TabItem>

            <TabItem Header="Vendor Performance">
                <Grid Margin="15">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="VendorGrid" ItemsSource="{Binding VendorReport}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vendor Name" Binding="{Binding VendorName}" Width="*"/>
                            <DataGridTextColumn Header="Approved Orders" Binding="{Binding OrderCount}" Width="150"/>
                            <DataGridTextColumn Header="Total Volume (USD)" Binding="{Binding TotalValue, StringFormat=N2}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Print Vendor Report" Command="{Binding PrintReportCommand}" CommandParameter="{Binding ElementName=VendorGrid}"
                            HorizontalAlignment="Right" Margin="0,15,0,0" Padding="15,10" Background="#27AE60"/>
                </Grid>
            </TabItem>

            <TabItem Header="Procurement Pipeline">
                <Grid Margin="15">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="PipelineGrid" ItemsSource="{Binding PipelineReport}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*"/>
                            <DataGridTextColumn Header="Document Count" Binding="{Binding Count}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Print Pipeline Summary" Command="{Binding PrintReportCommand}" CommandParameter="{Binding ElementName=PipelineGrid}"
                            HorizontalAlignment="Right" Margin="0,15,0,0" Padding="15,10" Background="#27AE60"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
