<UserControl x:Class="JaahdLogistics.Views.ProcurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JaahdLogistics.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <TabControl Margin="10">
        <TabItem Header="{DynamicResource RFQ}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource CreateRFQ}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource SelectPR}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding ApprovedPRs}" SelectedItem="{Binding SelectedPR}" DisplayMemberPath="PRNumber" Width="200"/>
                    <Button Content="{DynamicResource Generate}" Command="{Binding CreateRFQCommand}" Margin="10,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource RFQNumber}" Margin="5"/>
                    <TextBox Grid.Column="1" Text="{Binding CurrentRFQ.RFQNumber}" Margin="5"/>
                </Grid>
                <TextBlock Grid.Row="3" Text="{DynamicResource RFQDetailsPlaceholder}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
            </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource BidAnalysis}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="{DynamicResource AddBidder}" Command="{Binding AddBidderCommand}"/>
                    <Button Content="{DynamicResource Save}" Command="{Binding SaveBidAnalysisCommand}" Margin="10,0,0,0"/>
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Bidders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Name}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="True" CanUserAddRows="False"/>
                                </StackPanel>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource RecommendedBidder}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding Bidders}" SelectedValue="{Binding CurrentBidAnalysis.RecommendedBidderId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="200"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource PO}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="{DynamicResource CreatePO}" Command="{Binding CreatePOCommand}"/>
                    <CheckBox Content="Direct Purchase (Skip RFQ/Bid Analysis)" IsChecked="{Binding SkipBidAnalysis}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" x:Name="POPrintRoot">
                    <Grid Margin="15" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Title -->
                            <RowDefinition Height="Auto"/> <!-- Info -->
                            <RowDefinition Height="*"/>    <!-- Items -->
                            <RowDefinition Height="Auto"/> <!-- Terms -->
                            <RowDefinition Height="Auto"/> <!-- Signatures -->
                        </Grid.RowDefinitions>

                        <!-- Header for printing -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding DataContext.Settings.LogoImage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ImageBytesConverter}}"
                                   Height="60" Width="60" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.Settings.AssociationName, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Logistics Management" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource PO}" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                             <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                             <StackPanel Orientation="Horizontal" Margin="5">
                                 <TextBlock Text="{DynamicResource PO}" FontWeight="Bold"/>
                                 <TextBlock Text=" No:" FontWeight="Bold"/>
                             </StackPanel>
                             <TextBlock Grid.Column="1" Text="{Binding CurrentPO.PONumber}" Margin="5"/>
                             <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5">
                                 <TextBlock Text="{DynamicResource Date}" FontWeight="Bold"/>
                                 <TextBlock Text=":" FontWeight="Bold"/>
                             </StackPanel>
                             <TextBlock Grid.Column="3" Text="{Binding CurrentPO.Date, StringFormat=d}" Margin="5"/>
                        </Grid>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding CurrentPO.Items}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Description}" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Unit}" Binding="{Binding Unit}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource Quantity}" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource UnitPrice}" Binding="{Binding UnitPrice}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding TotalPrice}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="4" Margin="0,10">
                            <TextBlock Text="{DynamicResource TermsConditions}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentPO.Terms}" TextWrapping="Wrap" Margin="5"/>
                        </StackPanel>

                        <!-- Signatures Area -->
                        <UniformGrid Grid.Row="5" Columns="4" Margin="0,20,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Logistics Manager" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Finance Manager" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Project Manager" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Head of Association" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{DynamicResource Approve}" Command="{Binding ApprovePOCommand}" Width="120" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource Print}" Command="{Binding PrintCommand}" CommandParameter="{Binding ElementName=POPrintRoot}" Width="120"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
