<UserControl x:Class="JaahdLogistics.Views.ProcurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JaahdLogistics.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <DockPanel Margin="10">
        <GroupBox Header="Global Filters" DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{DynamicResource Project}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding FilterProject}" DisplayMemberPath="Name" Width="150"/>
                <Button Content="X" Command="{Binding ClearProjectFilterCommand}" Margin="2,0,10,0" Padding="5,0"/>

                <TextBlock Text="{DynamicResource Year}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox ItemsSource="{Binding FilterYears}" SelectedItem="{Binding FilterYear}" Width="80"/>
                <Button Content="X" Command="{Binding ClearYearFilterCommand}" Margin="2,0,10,0" Padding="5,0"/>
            </StackPanel>
        </GroupBox>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="{DynamicResource RFQ}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Side: List -->
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{DynamicResource RFQ}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="{DynamicResource New}" Command="{Binding NewRFQCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBox Text="{Binding RFQSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Tag="Search RFQ #..."/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredRFQs}" SelectedItem="{Binding SelectedRFQ}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RFQ #" Binding="{Binding RFQNumber}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="Auto"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Command="{Binding DataContext.DeleteRFQCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#C0392B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Right Side: Details/Create -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource CreateRFQ}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource SelectPR}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding PRSearchText, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,5,0" Tag="Search PR..."/>
                        <ComboBox ItemsSource="{Binding FilteredApprovedPRs}" SelectedItem="{Binding SelectedPR}" DisplayMemberPath="PRNumber" Width="100"
                                  IsSynchronizedWithCurrentItem="True"/>
                        <Button Content="🔄" Command="{Binding LoadApprovedPRsCommand}" Margin="5,0,0,0" ToolTip="Refresh PR List"/>
                        <Button Content="{DynamicResource Generate}" Command="{Binding CreateRFQCommand}" Margin="10,0,0,0"/>
                        <Button Content="{DynamicResource Save}" Command="{Binding SaveRFQCommand}" Margin="10,0,0,0" Background="#27AE60"/>
                        <Button Content="{DynamicResource Print}" Command="{Binding PrintCommand}" Margin="10,0,0,0" Background="#34495E"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="{DynamicResource RFQNumber}" Margin="5" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding CurrentRFQ.RFQNumber}" Margin="5"/>
                        
                        <TextBlock Grid.Column="2" Text="Closing Date" Margin="5" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding CurrentRFQ.ClosingDate}" Margin="5"/>
                        
                        <TextBlock Grid.Row="1" Text="Terms" Margin="5" VerticalAlignment="Top"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CurrentRFQ.Terms}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="5"/>
                    </Grid>
                    
                    <GroupBox Grid.Row="3" Header="RFQ Items (from PR)" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding SelectedPR.Items}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource BidAnalysis}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side: List -->
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{DynamicResource BidAnalysis}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="{DynamicResource New}" Command="{Binding NewBidAnalysisCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBox Text="{Binding BidSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Tag="Search Justification..."/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredBidAnalyses}" SelectedItem="{Binding SelectedBidAnalysis}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="*"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Command="{Binding DataContext.DeleteBidAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#C0392B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Right Side: Details/Edit (Matrix) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Select RFQ" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding RFQs}" SelectedItem="{Binding SelectedRFQ}" DisplayMemberPath="RFQNumber" Width="120" Margin="0,0,10,0"/>
                        <Button Content="{DynamicResource CreateNew}" Command="{Binding CreateBidAnalysisCommand}"/>
                        <Button Content="{DynamicResource AddBidder}" Command="{Binding AddBidderCommand}" Margin="5,0,0,0"/>
                        <Button Content="{DynamicResource Save}" Command="{Binding SaveBidAnalysisCommand}" Margin="5,0,0,0" Background="#27AE60"/>
                        <Button Content="{DynamicResource Approve}" Command="{Binding ApproveBidAnalysisCommand}" Margin="5,0,0,0"/>
                        <Button Content="{DynamicResource Print}" Command="{Binding PrintCommand}" Margin="5,0,0,0" Background="#34495E"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,15,0">
                            <!-- Comparison Matrix -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Background="#34495E">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Description" Foreground="White" FontWeight="Bold" Margin="10,5"/>
                                        <TextBlock Grid.Column="1" Text="Unit" Foreground="White" FontWeight="Bold" Margin="10,5" Width="50"/>
                                        <TextBlock Grid.Column="2" Text="Qty" Foreground="White" FontWeight="Bold" Margin="10,5" Width="50"/>
                                        <TextBlock Grid.Column="3" Text="Est. Price" Foreground="White" FontWeight="Bold" Margin="10,5" Width="70"/>
                                        <TextBlock Grid.Column="4" Text="Est. Total" Foreground="White" FontWeight="Bold" Margin="10,5" Width="70"/>
                                        <ItemsControl Grid.Column="5" ItemsSource="{Binding Bidders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="White" BorderThickness="1,0,0,0" Width="100">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding MatrixRows}">
                                        <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1">
                                                    <TextBlock Text="{Binding Description}" Margin="10,5" TextWrapping="Wrap"/>
                                                </Border>
                                                <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1,0,0,1" Width="50">
                                                    <TextBlock Text="{Binding Unit}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1,0,0,1" Width="50">
                                                    <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="3" BorderBrush="LightGray" BorderThickness="1,0,0,1" Width="70" Background="#FAD7A0">
                                                    <TextBlock Text="{Binding EstimativeUnitPrice, StringFormat=N2}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0"/>
                                                </Border>
                                                <Border Grid.Column="4" BorderBrush="LightGray" BorderThickness="1,0,0,1" Width="70" Background="#FAD7A0">
                                                    <TextBlock Text="{Binding EstimativeTotal, StringFormat=N2}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0"/>
                                                </Border>
                                                <ItemsControl Grid.Column="5" ItemsSource="{Binding BidderPrices}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="LightGray" BorderThickness="1,0,0,1" Width="100" Padding="5">
                                                                <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bidder Info Cards -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding Bidders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="SteelBlue" BorderThickness="1.5" Margin="5" Width="220" Padding="8" Background="White" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="Select Vendor" FontWeight="Bold" Margin="0,0,0,2" FontSize="11"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.Vendors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedValue="{Binding VendorId}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="Name"
                                                              Margin="0,0,0,5" Height="24"/>

                                                    <TextBlock Text="Bidder Name" FontWeight="Bold" Margin="0,0,0,2" FontSize="11"/>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Height="24"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Tel" Margin="0,0,0,2" FontSize="11"/>
                                                            <TextBox Text="{Binding Tel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Height="24"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                            <TextBlock Text="Email" Margin="0,0,0,2" FontSize="11"/>
                                                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Height="24"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="Justification/Reasons" FontWeight="Bold" Margin="0,2,0,2" FontSize="11"/>
                                                    <TextBox Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,0,0,5"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Discount" Margin="0,0,0,2" FontSize="11"/>
                                                            <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Height="24"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                            <TextBlock Text="Misc Costs" Margin="0,0,0,2" FontSize="11"/>
                                                            <TextBox Text="{Binding MiscCosts, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Height="24"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Separator Margin="0,5"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Subtotal: " FontSize="11"/>
                                                        <TextBlock Text="{Binding CalculatedSubTotal, StringFormat=N2}" FontWeight="Bold" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="GRAND TOTAL: " Foreground="DarkRed" FontSize="12" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding CalculatedTotal, StringFormat=N2}" FontWeight="Bold" Foreground="DarkRed" FontSize="12"/>
                                                    </StackPanel>

                                                    <Button Content="Award Winner" Command="{Binding DataContext.SetRecommendedBidderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,8,0,0" Height="30">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Background" Value="#F39C12"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                                                        <Setter Property="Background" Value="#27AE60"/>
                                                                        <Setter Property="Content" Value="WINNER!"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                                        <Button Content="📁" Command="{Binding DataContext.UploadQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Upload Quote Scan" Padding="5,2" Margin="0,0,2,0"/>
                                                        <Button Content="👁" Command="{Binding DataContext.ViewQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="View Quote Scan" Padding="5,2" Background="#34495E" Margin="0,0,2,0"/>
                                                        <Button Content="🗑" Command="{Binding DataContext.RemoveBidderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Remove Bidder" Padding="5,2" Background="#C0392B"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="{DynamicResource PO}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side: List -->
                <Grid Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{DynamicResource PO}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="{DynamicResource New}" Command="{Binding NewPOCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBox Text="{Binding POSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" Tag="Search PO # / Vendor..."/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredPOs}" SelectedItem="{Binding SelectedPO}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PO #" Binding="{Binding PONumber}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Command="{Binding DataContext.DeletePOCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#C0392B"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Right Side: Details -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Select PR" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding PRSearchText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,5,0" Tag="Search..."/>
                            <ComboBox ItemsSource="{Binding FilteredApprovedPRs}" SelectedItem="{Binding SelectedPR}" DisplayMemberPath="PRNumber" Width="100" Margin="0,0,10,0"/>
                            <TextBlock Text="Select Bid Analysis" VerticalAlignment="Center" Margin="10,0,10,0" Visibility="{Binding SkipBidAnalysis, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <ComboBox ItemsSource="{Binding FilteredBidAnalyses}" SelectedItem="{Binding SelectedBidAnalysis}" DisplayMemberPath="Id" Width="80" Margin="0,0,10,0" Visibility="{Binding SkipBidAnalysis, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Vendor" VerticalAlignment="Center" Margin="10,0,5,0" Visibility="{Binding SkipBidAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ComboBox ItemsSource="{Binding Vendors}" SelectedValue="{Binding CurrentPO.VendorId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="150" Margin="0,0,10,0" Visibility="{Binding SkipBidAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="{DynamicResource CreatePO}" Command="{Binding CreatePOCommand}"/>
                            <CheckBox Content="Direct Purchase (Skip RFQ/Bid Analysis)" IsChecked="{Binding SkipBidAnalysis}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                
                <ScrollViewer Grid.Row="1" x:Name="POPrintRoot">
                    <Grid Margin="15" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Title -->
                            <RowDefinition Height="Auto"/> <!-- Info -->
                            <RowDefinition Height="*"/>    <!-- Items -->
                            <RowDefinition Height="Auto"/> <!-- Terms -->
                            <RowDefinition Height="Auto"/> <!-- Signatures -->
                        </Grid.RowDefinitions>

                        <!-- Header for printing -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding DataContext.Settings.LogoImage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ImageBytesConverter}}" 
                                   Height="60" Width="60" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.Settings.AssociationName, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Logistics Management" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource PO}" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                             <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                             <StackPanel Orientation="Horizontal" Margin="5">
                                 <TextBlock Text="{DynamicResource PO}" FontWeight="Bold"/>
                                 <TextBlock Text=" No:" FontWeight="Bold"/>
                             </StackPanel>
                             <TextBox Grid.Column="1" Text="{Binding CurrentPO.PONumber}" Margin="5"/>

                             <TextBlock Grid.Column="2" Text="Clause:" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                             <TextBox Grid.Column="3" Text="{Binding CurrentPO.Clause}" Margin="5"/>

                             <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="5">
                                 <TextBlock Text="{DynamicResource Date}" FontWeight="Bold"/>
                                 <TextBlock Text=":" FontWeight="Bold"/>
                             </StackPanel>
                             <DatePicker Grid.Column="5" SelectedDate="{Binding CurrentPO.Date}" Margin="5"/>

                             <!-- Row 2: Project, Currency, Rate -->
                             <TextBlock Grid.Row="1" Text="{DynamicResource PRNumber}" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                             <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AllPRs}" SelectedValue="{Binding CurrentPO.PRId}" SelectedValuePath="Id" DisplayMemberPath="PRNumber" Margin="5"/>

                             <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Project}" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                             <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Projects}" SelectedValue="{Binding CurrentPO.ProjectId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="5"/>

                             <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                                 <TextBlock Text="{DynamicResource Currency}" FontWeight="Bold"/>
                                 <TextBlock Text="/" FontWeight="Bold"/>
                                 <TextBlock Text="{DynamicResource ExchangeRate}" FontWeight="Bold"/>
                             </StackPanel>
                             <Grid Grid.Row="1" Grid.Column="5">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*"/>
                                     <ColumnDefinition Width="*"/>
                                 </Grid.ColumnDefinitions>
                                 <ComboBox Text="{Binding CurrentPO.Currency}" Margin="2" IsEditable="True">
                                     <ComboBoxItem Content="USD"/>
                                     <ComboBoxItem Content="YER"/>
                                 </ComboBox>
                                 <TextBox Grid.Column="1" Text="{Binding CurrentPO.ExchangeRate}" Margin="2"/>
                             </Grid>

                             <!-- Vendor Details Summary -->
                             <Border Grid.Row="2" Grid.ColumnSpan="6" BorderBrush="SteelBlue" BorderThickness="1" Background="#F0F8FF" Padding="10" Margin="5">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="*"/>
                                     </Grid.ColumnDefinitions>
                                     <TextBlock Text="Vendor Name:" FontWeight="Bold" Margin="0,0,10,0"/>
                                     <TextBlock Grid.Column="1" Text="{Binding CurrentPO.VendorName}" FontWeight="Bold" Foreground="DarkBlue"/>

                                     <TextBlock Grid.Column="2" Text="Contact:" FontWeight="Bold" Margin="20,0,10,0"/>
                                     <TextBlock Grid.Column="3" Text="{Binding CurrentPO.VendorContact}" Foreground="DarkBlue"/>
                                 </Grid>
                             </Border>
                        </Grid>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding CurrentPO.Items}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Description}" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="{DynamicResource Unit}" Binding="{Binding Unit}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource Quantity}" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="{DynamicResource UnitPrice}" Binding="{Binding UnitPrice}" Width="100"/>
                                <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding TotalPrice}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="4" Margin="0,10">
                            <TextBlock Text="{DynamicResource TermsConditions}" FontWeight="Bold"/>
                            <TextBox Text="{Binding CurrentPO.Terms}" TextWrapping="Wrap" AcceptsReturn="True" Height="100" Margin="5"/>
                        </StackPanel>

                        <!-- Signatures Area -->
                        <UniformGrid Grid.Row="5" Columns="4" Margin="0,20,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Logistics Manager" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Finance Manager" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Project Manager" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Head of Association" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Border BorderBrush="LightGray" BorderThickness="1" Height="50" Width="120" Margin="5"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </ScrollViewer>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{DynamicResource Save}" Command="{Binding SavePOCommand}" Width="120" Margin="0,0,10,0" Background="#27AE60"/>
                    <Button Content="{DynamicResource Approve}" Command="{Binding ApprovePOCommand}" Width="120" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource Print}" Command="{Binding PrintCommand}" CommandParameter="{Binding ElementName=POPrintRoot}" Width="120"/>
                </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
    </DockPanel>
</UserControl>
