<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:JaahdLogistics.Helpers">

    <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <helpers:ImageBytesConverter x:Key="ImageBytesConverter"/>
    <helpers:CurrencyWordsConverter x:Key="CurrencyWordsConverter"/>
    <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    <helpers:BindingProxy x:Key="Proxy"/>
    
    <!-- Professional Color Palette -->
    <Color x:Key="PrimaryTealColor">#008080</Color>
    <Color x:Key="SecondaryBlueColor">#1B4F72</Color>
    <Color x:Key="LightGrayColor">#F2F4F4</Color>
    <Color x:Key="AccentGoldColor">#D4AC0D</Color>

    <SolidColorBrush x:Key="PrimaryTealBrush" Color="{StaticResource PrimaryTealColor}"/>
    <SolidColorBrush x:Key="SecondaryBlueBrush" Color="{StaticResource SecondaryBlueColor}"/>
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}"/>
    <SolidColorBrush x:Key="JaahdBlueBrush" Color="#1B4F72"/>
    <SolidColorBrush x:Key="JaahdBrownBrush" Color="#922B21"/>
    <SolidColorBrush x:Key="JaahdLightBlueBrush" Color="#AED6F1"/>
    <SolidColorBrush x:Key="JaahdLightBrownBrush" Color="#FAD7A0"/>

    <!-- Global Styles -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryTealBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryBlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="Silver"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SecondaryBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Report Styling -->
    <Style x:Key="ProfessionalReportStyle" TargetType="Grid">
        <Setter Property="Background" Value="White"/>
    </Style>

    <ControlTemplate x:Key="PrintFormTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="40" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Professional Letterhead Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" 
                           Height="80" Width="80" Stretch="Uniform" HorizontalAlignment="Left"/>
                    
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" 
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Data.Settings.Address, Source={StaticResource Proxy}}" 
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Data.Settings.ContactInfo, Source={StaticResource Proxy}}" 
                                   FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="" Visibility="Collapsed"/>
                </Grid>

                <Separator Grid.Row="1" Background="Black" Height="2" Margin="0,0,0,20"/>

                <!-- Specific PR Content for Template -->
                <Grid Grid.Row="2" x:Name="TemplateContent">
                    <TextBlock Text="Template Not Found" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Footer -->
                <TextBlock Grid.Row="3" Text="Generated by Jaahd Logistics Management System" 
                           FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="PRPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="25" BorderBrush="Black" BorderThickness="0.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Info Bar -->
                    <RowDefinition Height="Auto"/> <!-- Justification Bar -->
                    <RowDefinition Height="*"/>    <!-- Items Table -->
                    <RowDefinition Height="Auto"/> <!-- Summary -->
                    <RowDefinition Height="Auto"/> <!-- Signatures -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="60" Width="60" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="18" FontWeight="Bold" TextDecorations="Underline"/>
                        <TextBlock Text="Logistics Management" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Title Bar -->
                <Border Grid.Row="1" Background="{StaticResource JaahdBlueBrush}" Margin="0,0,0,10">
                    <TextBlock Text="Purchase Requisition / طلب شراء" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="5" FontSize="14"/>
                </Border>

                <!-- Info Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBlock Text="PR NUMBER / رقم الطلب :" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentPR.PRNumber}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="Project / المشروع :" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentPR.Project.Name}" FontSize="10"/>
                    </Border>
                    <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="DATE / التاريخ :" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5" Width="100">
                        <TextBlock Text="{Binding CurrentPR.Date, StringFormat=MM/dd/yyyy}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Justification / Currency Bar -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1">
                        <StackPanel>
                            <Border Background="{StaticResource JaahdBrownBrush}" Padding="3">
                                <TextBlock Text="Justification For The Request / مبررات الطلب" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentPR.Justification}" FontSize="9" Margin="5" Height="60" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Background="{StaticResource JaahdLightBrownBrush}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Type:" FontWeight="Bold" FontSize="9"/> <TextBlock Grid.Column="1" Text="{Binding CurrentPR.PRType}" FontSize="9" Margin="5,0" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Currency:" FontWeight="Bold" FontSize="9"/> <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentPR.Currency}" FontSize="9" Margin="5,0" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="Ex. Rate:" FontWeight="Bold" FontSize="9"/> <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPR.ExchangeRate}" FontSize="9" Margin="5,0" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="3" Text="PM:" FontWeight="Bold" FontSize="9"/> <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentPR.Project.ProjectManager}" FontSize="9" Margin="5,0" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Items Table -->
                <Grid Grid.Row="4">
                    <DataGrid ItemsSource="{Binding CurrentPR.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="1" BorderBrush="Black" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#D5D8DC"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="9"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SI NO." Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Item Description / المواصفات" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontSize" Value="9"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Clause / البند" Binding="{Binding BudgetLineId}" Width="60"/>
                            <DataGridTextColumn Header="Unit / الوحدة" Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="Qty / الكمية" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="Unit Price / السعر" Binding="{Binding UnitPrice, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Total / الإجمالي" Binding="{Binding TotalPrice, StringFormat=N2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Summary -->
                <Grid Grid.Row="5" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1,0,1,1" Padding="10" Background="#F2F4F4">
                        <StackPanel>
                            <TextBlock Text="Total in Words / الإجمالي كتابة:" FontWeight="Bold" FontSize="9"/>
                            <TextBlock FontWeight="Bold" FontSize="11" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyWordsConverter}">
                                        <Binding Path="CurrentPR.TotalAmount"/>
                                        <Binding Path="CurrentPR.Currency"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10" Background="#F2F4F4">
                        <TextBlock Text="{Binding CurrentPR.TotalAmount, StringFormat=N2}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Signatures -->
                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Requester / جهة الطلب" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="{Binding CurrentPR.RequesterTitle}" FontSize="8" HorizontalAlignment="Center" Margin="0,2" FontWeight="Bold"/>
                            <Separator/>
                            <Image Source="{Binding CurrentPR.RequesterSignature, Converter={StaticResource ImageBytesConverter}}" Height="50" Margin="2" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CurrentPR.RequesterName}" FontSize="9" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Verified / تم المراجعة" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="Logistic Manager / مدير اللوجستيات" FontSize="8" HorizontalAlignment="Center" Margin="0,2" FontWeight="Bold"/>
                            <Separator/>
                            <Image Source="{Binding CurrentPR.LogisticsSignature, Converter={StaticResource ImageBytesConverter}}" Height="50" Margin="2" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CurrentPR.LogisticsName}" FontSize="9" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Verified / تم المراجعة" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="Finance Manager / المدير المالي" FontSize="8" HorizontalAlignment="Center" Margin="0,2" FontWeight="Bold"/>
                            <Separator/>
                            <Image Source="{Binding CurrentPR.FinanceSignature, Converter={StaticResource ImageBytesConverter}}" Height="50" Margin="2" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CurrentPR.FinanceName}" FontSize="9" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Approved / تم الاعتماد" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center"/></Border>
                            <TextBlock Text="Head of Association / مدير الجمعية" FontSize="8" HorizontalAlignment="Center" Margin="0,2" FontWeight="Bold"/>
                            <Separator/>
                            <Image Source="{Binding CurrentPR.FinalSignature, Converter={StaticResource ImageBytesConverter}}" Height="50" Margin="2" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CurrentPR.FinalName}" FontSize="9" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="RFQPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="25" BorderBrush="Black" BorderThickness="0.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Info Bar -->
                    <RowDefinition Height="*"/>    <!-- Items Table -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="60" Width="60" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="18" FontWeight="Bold" TextDecorations="Underline"/>
                        <TextBlock Text="Logistics Management" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Title Bar -->
                <Border Grid.Row="1" Background="{StaticResource JaahdBlueBrush}" Margin="0,0,0,10">
                    <TextBlock Text="Request for Quotation (RFQ) / طلب عرض سعر" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="5" FontSize="14"/>
                </Border>

                <!-- Info Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBlock Text="RFQ Number / رقم طلب عرض السعر :" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentRFQ.RFQNumber}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="Closing Date / تاريخ الإغلاق" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentRFQ.ClosingDate, StringFormat=MM/dd/yyyy}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Items Table -->
                <Grid Grid.Row="3">
                    <DataGrid ItemsSource="{Binding SelectedPR.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="1" BorderBrush="Black" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#D5D8DC"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="9"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SI NO." Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Item Description / المواصفات" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontSize" Value="9"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit / الوحدة" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Qty / الكمية" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Unit Price / السعر" Width="100"/>
                            <DataGridTextColumn Header="Total / الإجمالي" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="4" Margin="0,15,0,0">
                    <Border BorderBrush="Black" BorderThickness="1">
                        <StackPanel>
                            <Border Background="{StaticResource JaahdBrownBrush}" Padding="3">
                                <TextBlock Text="{DynamicResource TermsConditions}" Foreground="White" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentRFQ.Terms}" FontSize="9" Margin="5" Height="60" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,10,0">
                            <StackPanel>
                                <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Service Provider Details / تفاصيل مزود الخدمة" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center"/></Border>
                                <Grid Margin="5">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Name:" FontSize="8" FontWeight="Bold"/> <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="5,0,0,5" Height="15"/>
                                    <TextBlock Grid.Row="1" Text="Contact:" FontSize="8" FontWeight="Bold"/> <Border Grid.Row="1" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="5,0,0,5" Height="15"/>
                                    <TextBlock Grid.Row="2" Text="Tel:" FontSize="8" FontWeight="Bold"/> <Border Grid.Row="2" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="5,0,0,5" Height="15"/>
                                    <TextBlock Grid.Row="3" Text="Email:" FontSize="8" FontWeight="Bold"/> <Border Grid.Row="3" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="5,0,0,5" Height="15"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                            <StackPanel>
                                <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Vendor Signature &amp; Stamp / توقيع وختم المورد" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center"/></Border>
                                <Border Height="80"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="BidAnalysisPrintTemplate">
        <Border Background="White" Width="1122" Height="793" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- Info Bar -->
                    <RowDefinition Height="Auto"/> <!-- Justification -->
                    <RowDefinition Height="*"/>    <!-- Comparison Matrix -->
                    <RowDefinition Height="Auto"/> <!-- Recommendation -->
                    <RowDefinition Height="Auto"/> <!-- Signatures -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="50" Width="50"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="14" FontWeight="Bold" TextDecorations="Underline"/>
                        <TextBlock Text="Logistics Management" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#1B4F72" Margin="0,5">
                    <TextBlock Text="Analysis of RFQs" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
                </Border>

                <!-- Info Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBlock Text="RFQ or Tender reference number" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentRFQ.RFQNumber}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="Date of Analysis:" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5" Width="100">
                        <TextBlock Text="{Binding CurrentBidAnalysis.Date, StringFormat=MM/dd/yyyy}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Justification -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#922B21" Padding="5" Width="250">
                        <TextBlock Text="Justification For The Request" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBlock Text="{Binding CurrentBidAnalysis.Justification}" FontSize="9"/>
                    </Border>
                </Grid>

                <!-- Matrix -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Bidders header rows -->
                        <RowDefinition Height="*"/>    <!-- Items rows -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/> <!-- NO -->
                            <ColumnDefinition Width="200"/> <!-- Description -->
                            <ColumnDefinition Width="50"/> <!-- Unit -->
                            <ColumnDefinition Width="50"/> <!-- QTY -->
                            <ColumnDefinition Width="120"/> <!-- Estimative -->
                            <ColumnDefinition Width="*"/> <!-- Bidders -->
                        </Grid.ColumnDefinitions>

                        <!-- Column 0-4 are static, Column 5 is dynamic bidders -->
                        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1,1,1,1" Padding="2"><TextBlock Text="NO" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="2"><TextBlock Text="Description" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="2"><TextBlock Text="Unit" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="2"><TextBlock Text="QTY" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,1,1">
                             <StackPanel>
                                 <Border Background="#FAD7A0" Padding="2" BorderBrush="Black" BorderThickness="0,0,0,1"><TextBlock Text="{DynamicResource EstimativeCost}" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center"/></Border>
                                 <Grid>
                                     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                     <Border BorderBrush="Black" BorderThickness="0,0,1,0" Padding="1"><TextBlock Text="Unit Price" FontSize="7" HorizontalAlignment="Center"/></Border>
                                     <Border Grid.Column="1" Padding="1"><TextBlock Text="Total" FontSize="7" HorizontalAlignment="Center"/></Border>
                                 </Grid>
                             </StackPanel>
                        </Border>

                        <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,1,1,1">
                            <ItemsControl ItemsSource="{Binding Bidders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black" BorderThickness="0,0,1,0" Width="120">
                                            <StackPanel>
                                                <!-- Top: Bidder Info -->
                                                <Border BorderBrush="Black" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource BidderHeader}" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" Margin="2"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Address}" FontSize="8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Bottom: Sub-headers -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Border BorderBrush="Black" BorderThickness="0,0,1,0" Padding="1"><TextBlock Text="Unit Price" FontSize="7" HorizontalAlignment="Center"/></Border>
                                                    <Border Grid.Column="1" Padding="1"><TextBlock Text="Total" FontSize="7" HorizontalAlignment="Center"/></Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MatrixRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="Black" BorderThickness="1,0,1,1"><TextBlock Text="{Binding Index}" FontSize="8" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1"><TextBlock Text="{Binding Description}" FontSize="8" Margin="2" TextWrapping="Wrap"/></Border>
                                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1"><TextBlock Text="{Binding Unit}" FontSize="8" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,1"><TextBlock Text="{Binding Quantity}" FontSize="8" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,0,1,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border BorderBrush="Black" BorderThickness="0,0,1,0"><TextBlock Text="{Binding EstimativeUnitPrice, StringFormat=N2}" FontSize="8" HorizontalAlignment="Center"/></Border>
                                            <Border Grid.Column="1"><TextBlock Text="{Binding EstimativeTotal, StringFormat=N2}" FontSize="8" HorizontalAlignment="Center"/></Border>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,0,1">
                                        <ItemsControl ItemsSource="{Binding BidderPrices}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="120">
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Border BorderBrush="Black" BorderThickness="0,0,1,0"><TextBlock Text="{Binding UnitPrice, StringFormat=N2}" FontSize="8" HorizontalAlignment="Center"/></Border>
                                                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0"><TextBlock Text="{Binding TotalPrice, StringFormat=N2}" FontSize="8" HorizontalAlignment="Center"/></Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Footer section: Totals -->
                <Grid Grid.Row="5" Margin="0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1" Background="#EBF5FB" Padding="2"><TextBlock Text="{DynamicResource SubTotal}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Right"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1">
                             <ItemsControl ItemsSource="{Binding Bidders}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black" BorderThickness="0,0,1,0" Width="120" Padding="2">
                                            <TextBlock Text="{Binding CalculatedSubTotal, StringFormat=N2}" FontSize="9" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Blue"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#EBF5FB" Padding="2"><TextBlock Text="{DynamicResource Discount}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Right"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1">
                             <ItemsControl ItemsSource="{Binding Bidders}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black" BorderThickness="0,0,1,0" Width="120" Padding="2">
                                            <TextBlock Text="{Binding Discount, StringFormat=N2}" FontSize="9" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#EBF5FB" Padding="2"><TextBlock Text="{DynamicResource MiscCosts}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Right"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1">
                             <ItemsControl ItemsSource="{Binding Bidders}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black" BorderThickness="0,0,1,0" Width="120" Padding="2">
                                            <TextBlock Text="{Binding MiscCosts, StringFormat=N2}" FontSize="9" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#EBF5FB" Padding="2"><TextBlock Text="{DynamicResource GeneralTotal}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Right"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1">
                             <ItemsControl ItemsSource="{Binding Bidders}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black" BorderThickness="0,0,1,0" Width="120" Padding="2">
                                            <TextBlock Text="{Binding CalculatedTotal, StringFormat=N2}" FontSize="9" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#D5F5E3" Padding="2"><TextBlock Text="{DynamicResource RecomAwardTo}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding CurrentBidAnalysis.RecommendedBidderName}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/></Border>
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#FCF3CF" Padding="2"><TextBlock Text="Recommendation Reasons / مبررات الاختيار" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding CurrentBidAnalysis.RecommendationReasons}" FontSize="10" HorizontalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap"/></Border>
                    </Grid>

                    <Border Grid.Row="6" BorderBrush="Black" BorderThickness="1,0,1,1" Background="#D5D8DC" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource TotalInWords}" FontWeight="Bold" FontSize="9"/>
                            <TextBlock FontWeight="Bold" FontSize="9" Margin="5,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyWordsConverter}">
                                        <Binding Path="CurrentBidAnalysis.RecommendedBidderTotal"/>
                                        <Binding Path="CurrentBidAnalysis.Currency"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Signatures -->
                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Checked by :" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                            <Grid Margin="5">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="POSITION :" FontWeight="Bold" FontSize="8"/> <TextBlock Grid.Column="1" Text="Logistic Manager" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="1" Text="Name :" FontSize="8"/> <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogisticsNameBA}" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="2" Text="Date :" FontSize="8"/> <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentBidAnalysis.Date, StringFormat=d}" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="3" Text="Signature" FontSize="8"/>
                                <Image Grid.Row="3" Grid.Column="1" Source="{Binding LogisticsSignatureBA, Converter={StaticResource ImageBytesConverter}}" Height="30" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Reviewed by :" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                            <Grid Margin="5">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="POSITION :" FontWeight="Bold" FontSize="8"/> <TextBlock Grid.Column="1" Text="Finance Manager" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="1" Text="Name :" FontSize="8"/> <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FinanceNameBA}" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="2" Text="Date :" FontSize="8"/> <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentBidAnalysis.Date, StringFormat=d}" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="3" Text="Signature" FontSize="8"/>
                                <Image Grid.Row="3" Grid.Column="1" Source="{Binding FinanceSignatureBA, Converter={StaticResource ImageBytesConverter}}" Height="30" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                        <StackPanel>
                            <Border Background="#D5D8DC" Padding="2"><TextBlock Text="Approved by :" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                            <Grid Margin="5">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="POSITION :" FontWeight="Bold" FontSize="8"/> <TextBlock Grid.Column="1" Text="Head of Association" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="1" Text="Name :" FontSize="8"/> <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HeadNameBA}" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="2" Text="Date :" FontSize="8"/> <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentBidAnalysis.Date, StringFormat=d}" FontSize="8" Margin="5,0"/>
                                <TextBlock Grid.Row="3" Text="Signature" FontSize="8"/>
                                <Image Grid.Row="3" Grid.Column="1" Source="{Binding HeadSignatureBA, Converter={StaticResource ImageBytesConverter}}" Height="30" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="POPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo/Header -->
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- PO No / Clause / Date -->
                    <RowDefinition Height="Auto"/> <!-- Details Section -->
                    <RowDefinition Height="*"/>    <!-- Items Table -->
                    <RowDefinition Height="Auto"/> <!-- Terms Section -->
                    <RowDefinition Height="Auto"/> <!-- Signatures Section -->
                </Grid.RowDefinitions>

                <!-- 1. Logo and Header -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="60" Width="60"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="14" FontWeight="Bold" TextDecorations="Underline"/>
                        <TextBlock Text="Logistics Management / إدارة اللوجستيات" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Title -->
                <Border Grid.Row="1" Background="#1B4F72" Margin="0,0,0,10">
                    <TextBlock Text="PURCHASE ORDER / أمر شراء" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
                </Border>

                <!-- 3. PO No / Clause / Date -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBlock Text="PO NUMBER / رقم الأمر :" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentPO.PONumber}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="CLAUSE / البند :" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentPO.Clause}" FontSize="10"/>
                    </Border>
                    <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="DATE / التاريخ :" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5" Width="100">
                        <TextBlock Text="{Binding CurrentPO.Date, StringFormat=MM/dd/yyyy}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 4. Details Section (JAAHD vs VENDOR) -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- JAAHD Column -->
                    <Border BorderBrush="Black" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" Background="#922B21" Padding="5">
                                <TextBlock Text="DETAILS: JAAHD / تفاصيل جهة الطلب" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>

                            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5" Background="#F2F3F4">
                                <TextBlock Text="NAME / الاسم:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,1" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                                <TextBlock Text="Contact / التواصل:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.ContactInfo, Source={StaticResource Proxy}}" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="3" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                                <TextBlock Text="Tel / الهاتف:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.Tel, Source={StaticResource Proxy}}" HorizontalAlignment="Center" FontSize="9"/>
                            </Border>

                            <Border Grid.Row="4" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                                <TextBlock Text="Email / البريد:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.Email, Source={StaticResource Proxy}}" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="5" BorderBrush="Black" BorderThickness="0,0,1,0" Padding="5">
                                <TextBlock Text="ADDRESS / العنوان:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.Address, Source={StaticResource Proxy}}" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- VENDOR Column -->
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" Background="#AED6F1" Padding="5">
                                <TextBlock Text="VENDOR / تفاصيل المورد" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" FontSize="10"/>
                            </Border>

                            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5" Background="#F2F3F4">
                                <TextBlock Text="NAME / الاسم:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,1" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.VendorName}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                                <TextBlock Text="Contact / التواصل:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.VendorContact}" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="3" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                                <TextBlock Text="Tel / الهاتف:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.VendorTel}" HorizontalAlignment="Center" FontSize="9"/>
                            </Border>

                            <Border Grid.Row="4" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                                <TextBlock Text="Email / البريد:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.VendorEmail}" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>

                            <Border Grid.Row="5" BorderBrush="Black" BorderThickness="0,0,1,0" Padding="5">
                                <TextBlock Text="ADDRESS / العنوان:" FontWeight="Bold" HorizontalAlignment="Right" FontSize="9"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.VendorAddress}" HorizontalAlignment="Center" FontSize="9" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. Items Table -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding CurrentPO.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="1" BorderBrush="Black" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#D5D8DC"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description / المواصفات" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit / الوحدة" Binding="{Binding Unit}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Qty / الكمية" Binding="{Binding Quantity}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="U.Price / السعر" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total / الإجمالي" Binding="{Binding TotalPrice, StringFormat=N2}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Margin" Value="0,0,5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#D5D8DC" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource TotalCost}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock FontWeight="Bold" TextWrapping="Wrap" FontSize="10">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CurrencyWordsConverter}">
                                            <Binding Path="CurrentPO.TotalAmount"/>
                                            <Binding Path="CurrentPO.Currency"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Background="#D5D8DC" Padding="10">
                            <TextBlock Text="{Binding CurrentPO.TotalAmount, StringFormat=N2}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 6. Terms Section -->
                <Border Grid.Row="5" BorderBrush="Black" BorderThickness="1" Margin="0,10,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#D5D8DC" Padding="5">
                            <TextBlock Text="{DynamicResource SupplyTerms}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{Binding CurrentPO.Terms}" TextWrapping="Wrap" Margin="10" FontSize="10"/>
                    </Grid>
                </Border>

                <!-- 7. Signatures Section -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logistics -->
                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,2,0" Padding="5">
                        <StackPanel>
                            <Border Background="#AED6F1" Margin="-5,-5,-5,5">
                                <TextBlock Text="{DynamicResource CheckedBy}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="9"/>
                            </Border>
                            <TextBlock Text="{DynamicResource LogisticManager}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Separator Margin="0,2"/>
                            <TextBlock Text="{Binding CurrentPO.LogisticsName}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <Image Source="{Binding CurrentPO.LogisticsSignature, Converter={StaticResource ImageBytesConverter}}" Height="35" HorizontalAlignment="Center" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Finance -->
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,2,0" Padding="5">
                        <StackPanel>
                            <Border Background="#D5D8DC" Margin="-5,-5,-5,5">
                                <TextBlock Text="{DynamicResource ReviewedBy}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="9"/>
                            </Border>
                            <TextBlock Text="{DynamicResource FinanceManager}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Separator Margin="0,2"/>
                            <TextBlock Text="{Binding CurrentPO.FinanceName}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <Image Source="{Binding CurrentPO.FinanceSignature, Converter={StaticResource ImageBytesConverter}}" Height="35" HorizontalAlignment="Center" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Head -->
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Padding="5">
                        <StackPanel>
                            <Border Background="#D5D8DC" Margin="-5,-5,-5,5">
                                <TextBlock Text="{DynamicResource FinalApproved}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="9"/>
                            </Border>
                            <TextBlock Text="Head / مدير الجمعية" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Separator Margin="0,2"/>
                            <TextBlock Text="{Binding CurrentPO.FinalName}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <Image Source="{Binding CurrentPO.FinalSignature, Converter={StaticResource ImageBytesConverter}}" Height="35" HorizontalAlignment="Center" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="GRNPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="25" BorderBrush="Black" BorderThickness="0.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Info Bar -->
                    <RowDefinition Height="Auto"/> <!-- Details Bar -->
                    <RowDefinition Height="*"/>    <!-- Items Table -->
                    <RowDefinition Height="Auto"/> <!-- Remarks Section -->
                    <RowDefinition Height="Auto"/> <!-- Signatures -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Settings.LogoImage, Converter={StaticResource ImageBytesConverter}}" Height="60" Width="60" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="GOODS RECEIVING NOTE" FontSize="18" FontWeight="Bold" Foreground="{StaticResource JaahdBlueBrush}"/>
                        <TextBlock Text="Supply Management and Logistics Service" FontSize="12" Foreground="{StaticResource JaahdBlueBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Info Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBlock Text="DISTRIBUTION :-" FontWeight="Bold" FontSize="9" Foreground="{StaticResource JaahdBlueBrush}"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding SelectedPO.Project.Name}" FontSize="10"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="GRN NO." FontWeight="Bold" FontSize="9" Foreground="{StaticResource JaahdBlueBrush}"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentGRN.GRNNumber}" FontSize="10" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Details Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel>
                            <Border Background="#FAD7A0" Padding="5"><TextBlock Text="VENDOR DETAILS" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/></Border>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="NAME:" FontWeight="Bold" FontSize="9" Foreground="{StaticResource JaahdBlueBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPO.VendorName}" FontWeight="Bold" FontSize="11" Margin="10,0"/>
                                <TextBlock Grid.Row="1" Text="SUPPLY TYPE:" FontWeight="Bold" FontSize="8" Foreground="{StaticResource JaahdBlueBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Materials" FontSize="8" Margin="10,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                        <StackPanel>
                            <Border Background="White" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5"><TextBlock Text="PURCHASE ORDER DETAILS" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/></Border>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="PO. NO. :-" FontWeight="Bold" FontSize="9" Foreground="{StaticResource JaahdBlueBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPO.PONumber}" FontWeight="Bold" FontSize="9" Margin="10,0" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="INVOICE NO. :-" FontWeight="Bold" FontSize="9" Foreground="{StaticResource JaahdBlueBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentGRN.InvoiceNumber}" FontSize="9" Margin="10,0" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Items Table -->
                <DataGrid Grid.Row="3" ItemsSource="{Binding GrnItems}" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="1" BorderBrush="Black" HeadersVisibility="Column" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="8"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="SI NO." Width="40">
                             <DataGridTemplateColumn.CellTemplate>
                                 <DataTemplate><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" HorizontalAlignment="Center"/></DataTemplate>
                             </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ITEM DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="TOT ITEMS RECEIVED" Binding="{Binding ReceivedQuantity}" Width="80">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="NO. ACCEPTED" Binding="{Binding AcceptedQuantity}" Width="80">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="NO. REJECTED" Binding="{Binding RejectedQuantity}" Width="80"/>
                        <DataGridTextColumn Header="REJECT REASON(S)" Binding="{Binding RejectReason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Remarks Section -->
                <Grid Grid.Row="4" Margin="0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1">
                        <StackPanel>
                            <Border Background="{StaticResource JaahdBlueBrush}" Width="150" HorizontalAlignment="Left" Padding="5">
                                <TextBlock Text="REMARKS" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Ellipse Fill="{StaticResource JaahdBlueBrush}" Width="6" Height="6" Margin="0,0,10,0"/>
                                    <TextBlock Text="Quantity Comply to The Required Specifications" Foreground="{StaticResource JaahdBlueBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Ellipse Fill="{StaticResource JaahdBlueBrush}" Width="6" Height="6" Margin="0,0,10,0"/>
                                    <TextBlock Text="Quantity Matches The Required Number" Foreground="{StaticResource JaahdBlueBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Ellipse Fill="{StaticResource JaahdBlueBrush}" Width="6" Height="6" Margin="0,0,10,0"/>
                                    <TextBlock Text="Quantity Intact" Foreground="{StaticResource JaahdBlueBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1">
                        <StackPanel VerticalAlignment="Center">
                             <CheckBox IsChecked="{Binding CurrentGRN.IsQtyComply}" HorizontalAlignment="Center" Margin="0,10" IsEnabled="False"/>
                             <CheckBox IsChecked="{Binding CurrentGRN.IsQtyMatch}" HorizontalAlignment="Center" Margin="0,10" IsEnabled="False"/>
                             <CheckBox IsChecked="{Binding CurrentGRN.IsQtyIntact}" HorizontalAlignment="Center" Margin="0,10" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Signatures -->
                <Border Grid.Row="5" BorderBrush="Black" BorderThickness="1">
                    <StackPanel>
                        <Border Padding="5"><TextBlock Text="RECEIVER DETAILS" FontWeight="Bold" Foreground="Brown" FontSize="11"/></Border>
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                            <TextBlock Text="NAME" FontWeight="Bold" TextDecorations="Underline" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                                <TextBlock Text="{Binding ReceiverName}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="2" Text="POSITION" FontWeight="Bold" TextDecorations="Underline" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Border Grid.Column="3" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                                <TextBlock Text="{Binding ReceiverPosition}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1" Text="SIGNATURE" FontWeight="Bold" TextDecorations="Underline" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5" Height="30">
                                <Image Source="{Binding ReceiverSignature, Converter={StaticResource ImageBytesConverter}}"/>
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="RECEIVING DATE" FontWeight="Bold" TextDecorations="Underline" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Border Grid.Row="1" Grid.Column="3" BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                                <TextBlock Text="{Binding CurrentGRN.Date, StringFormat=d}" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ThreeWayMatchPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="25" BorderBrush="Black" BorderThickness="0.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Info Bar 1 -->
                    <RowDefinition Height="Auto"/> <!-- Info Bar 2 -->
                    <RowDefinition Height="*"/>    <!-- Comparison Table -->
                    <RowDefinition Height="Auto"/> <!-- Signatures -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Settings.LogoImage, Converter={StaticResource ImageBytesConverter}}" Height="60" Width="60" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Settings.AssociationName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource JaahdBlueBrush}" TextDecorations="Underline"/>
                        <TextBlock Text="Logistics Management" FontSize="14" Foreground="Black" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Title Bar -->
                <Border Grid.Row="1" Background="{StaticResource PrimaryTealBrush}" Margin="0,0,0,10">
                    <TextBlock Text="(Three-Way Match)" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="3" FontSize="12"/>
                </Border>

                <!-- Info Bar 1 -->
                <Grid Grid.Row="2" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Background="#E9F7EF" Padding="5">
                        <TextBlock Text="{DynamicResource PONumberHeader}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding SelectedPO.PONumber}" FontSize="8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Background="#FAD7A0" Padding="5">
                        <TextBlock Text="{DynamicResource GRNNumberHeader}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding GrnNumber}" FontSize="8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,1,1" Background="#D5D8DC" Padding="5">
                        <TextBlock Text="{DynamicResource TWMDate}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentMatch.Date, StringFormat=MM/dd/yyyy}" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Info Bar 2 (Invoice / Description / TWM No) -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#D6EAF8" Padding="5">
                        <TextBlock Text="{DynamicResource InvoiceNo}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Background="#D6EAF8" Padding="5">
                        <TextBlock Text="{DynamicResource Description}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1" Background="#D6EAF8" Padding="5">
                        <TextBlock Text="{DynamicResource TWMNumber}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Values row -->
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1,0,1,1" Padding="5" Grid.Column="0">
                        <TextBlock Text="{Binding CurrentMatch.InvoiceNumber}" FontSize="9" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentMatch.InvoiceDetails}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentMatch.TWMNumber}" FontSize="8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!-- Comparison Table -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header rows -->
                        <RowDefinition Height="*"/>    <!-- Data rows -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/> <!-- Item -->
                            <ColumnDefinition Width="40"/>  <!-- Unit -->
                            <ColumnDefinition Width="100"/> <!-- PO -->
                            <ColumnDefinition Width="100"/> <!-- Extracts -->
                            <ColumnDefinition Width="100"/> <!-- GRN -->
                            <ColumnDefinition Width="60"/>  <!-- Diff Note -->
                            <ColumnDefinition Width="*"/>   <!-- Clarify -->
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="Black" BorderThickness="1" Background="#F2F4F4" Padding="5"><TextBlock Text="{DynamicResource ItemHeader}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9"/></Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Background="#F2F4F4" Padding="5"><TextBlock Text="{DynamicResource Unit}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9"/></Border>

                        <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1">
                            <StackPanel>
                                <Border Background="#F2F4F4" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="2"><TextBlock Text="{DynamicResource POContract}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border BorderBrush="Black" BorderThickness="0,0,1,0" Padding="2"><TextBlock Text="Price" FontSize="8" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Column="1" Padding="2"><TextBlock Text="Quantity" FontSize="8" HorizontalAlignment="Center"/></Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1">
                            <StackPanel>
                                <Border Background="#F2F4F4" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="2"><TextBlock Text="{DynamicResource Extracts}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border BorderBrush="Black" BorderThickness="0,0,1,0" Padding="2"><TextBlock Text="Price" FontSize="8" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Column="1" Padding="2"><TextBlock Text="Quantity" FontSize="8" HorizontalAlignment="Center"/></Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,1,1">
                            <StackPanel>
                                <Border Background="#F2F4F4" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="2"><TextBlock Text="{DynamicResource GRNDetail}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border BorderBrush="Black" BorderThickness="0,0,1,0" Padding="2"><TextBlock Text="Price" FontSize="8" HorizontalAlignment="Center"/></Border>
                                    <Border Grid.Column="1" Padding="2"><TextBlock Text="Quantity" FontSize="8" HorizontalAlignment="Center"/></Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,1,1,1" Background="#F2F4F4" Padding="5"><TextBlock Text="Diff Note" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8"/></Border>
                        <Border Grid.Column="6" BorderBrush="Black" BorderThickness="0,1,1,1" Background="#F2F4F4" Padding="5"><TextBlock Text="Clarify the Diff" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8"/></Border>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CurrentMatch.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="Black" BorderThickness="1,0,1,1" Padding="5"><TextBlock Text="{Binding Description}" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding Unit}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding POPrice, StringFormat=N2}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding POQuantity}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                                    <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding ExtractPrice, StringFormat=N2}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding ExtractQuantity}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                                    <Border Grid.Column="6" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding GRNPrice, StringFormat=N2}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Grid.Column="7" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding GRNQuantity}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                                    <Border Grid.Column="8" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="2"><TextBlock Text="{Binding DiffNote}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                                    <Border Grid.Column="9" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="5"><TextBlock Text="{Binding ClarifyDiff}" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Signatures -->
                <Grid Grid.Row="5" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Padding="4" Background="#D5D8DC"><TextBlock Text="Checked by / فحص بواسطة" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                            <StackPanel Margin="8">
                                <TextBlock Text="Logistic Manager / مدير اللوجستيات" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Separator Margin="0,5"/>
                                <TextBlock Text="{Binding LogisticsNameTWM}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image Source="{Binding LogisticsSignatureTWM, Converter={StaticResource ImageBytesConverter}}" Height="50" Margin="0,5" Stretch="Uniform"/>
                                <TextBlock Text="{Binding CurrentMatch.Date, StringFormat=MM/dd/yyyy}" FontSize="8" HorizontalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Padding="4" Background="#D5D8DC"><TextBlock Text="Reviewed by / مراجعة بواسطة" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                            <StackPanel Margin="8">
                                <TextBlock Text="Finance Manager / المدير المالي" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Separator Margin="0,5"/>
                                <TextBlock Text="{Binding FinanceNameTWM}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image Source="{Binding FinanceSignatureTWM, Converter={StaticResource ImageBytesConverter}}" Height="50" Margin="0,5" Stretch="Uniform"/>
                                <TextBlock Text="{Binding CurrentMatch.Date, StringFormat=MM/dd/yyyy}" FontSize="8" HorizontalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                        <StackPanel>
                            <Border Padding="4" Background="#D5D8DC"><TextBlock Text="Approved by / اعتمد بواسطة" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                            <StackPanel Margin="8">
                                <TextBlock Text="Head / PM" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Separator Margin="0,5"/>
                                <TextBlock Text="{Binding HeadNameTWM}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Image Source="{Binding HeadSignatureTWM, Converter={StaticResource ImageBytesConverter}}" Height="50" Margin="0,5" Stretch="Uniform"/>
                                <TextBlock Text="{Binding CurrentMatch.Date, StringFormat=MM/dd/yyyy}" FontSize="8" HorizontalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>
</ResourceDictionary>
