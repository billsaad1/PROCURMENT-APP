<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:JaahdLogistics.Helpers">

    <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <helpers:ImageBytesConverter x:Key="ImageBytesConverter"/>
    <helpers:CurrencyWordsConverter x:Key="CurrencyWordsConverter"/>
    <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    <helpers:BindingProxy x:Key="Proxy"/>
    
    <!-- Professional Color Palette -->
    <Color x:Key="PrimaryTealColor">#008080</Color>
    <Color x:Key="SecondaryBlueColor">#1B4F72</Color>
    <Color x:Key="LightGrayColor">#F2F4F4</Color>
    <Color x:Key="AccentGoldColor">#D4AC0D</Color>

    <SolidColorBrush x:Key="PrimaryTealBrush" Color="{StaticResource PrimaryTealColor}"/>
    <SolidColorBrush x:Key="SecondaryBlueBrush" Color="{StaticResource SecondaryBlueColor}"/>
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}"/>

    <!-- Global Styles -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryTealBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryBlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="Silver"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SecondaryBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Report Styling -->
    <Style x:Key="ProfessionalReportStyle" TargetType="Grid">
        <Setter Property="Background" Value="White"/>
    </Style>

    <ControlTemplate x:Key="PrintFormTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="40" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Professional Letterhead Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" 
                           Height="80" Width="80" Stretch="Uniform" HorizontalAlignment="Left"/>
                    
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" 
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Data.Settings.Address, Source={StaticResource Proxy}}" 
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Data.Settings.ContactInfo, Source={StaticResource Proxy}}" 
                                   FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="" Visibility="Collapsed"/>
                </Grid>

                <Separator Grid.Row="1" Background="Black" Height="2" Margin="0,0,0,20"/>

                <!-- Specific PR Content for Template -->
                <Grid Grid.Row="2" x:Name="TemplateContent">
                    <TextBlock Text="Template Not Found" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Footer -->
                <TextBlock Grid.Row="3" Text="Generated by Jaahd Logistics Management System" 
                           FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="PRPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="80" Width="80"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Purchase Requisition" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Margin="0,0,0,20"/>

                <!-- Info -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PR Number:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentPR.PRNumber}" Margin="5"/>
                    <TextBlock Grid.Column="2" Text="Date:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Column="3" Text="{Binding CurrentPR.Date, StringFormat=d}" Margin="5"/>
                </Grid>

                <!-- Items -->
                <DataGrid Grid.Row="3" ItemsSource="{Binding CurrentPR.Items}" AutoGenerateColumns="False" 
                          IsReadOnly="True" BorderThickness="1" BorderBrush="Black">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice}" Width="80"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Summary -->
                <StackPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,10">
                    <TextBlock Text="{Binding CurrentPR.TotalAmount, StringFormat='Total: {0:N2}'}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <!-- Signatures -->
                <UniformGrid Grid.Row="5" Columns="4" Margin="0,40,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Requester" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="120" Margin="5">
                             <Image Source="{Binding CurrentPR.RequesterSignature, Converter={StaticResource ImageBytesConverter}}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentPR.RequesterName}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Logistics" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="120" Margin="5">
                             <Image Source="{Binding CurrentPR.LogisticsSignature, Converter={StaticResource ImageBytesConverter}}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentPR.LogisticsName}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Finance" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="120" Margin="5">
                             <Image Source="{Binding CurrentPR.FinanceSignature, Converter={StaticResource ImageBytesConverter}}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentPR.FinanceName}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Approved By" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="120" Margin="5">
                             <Image Source="{Binding CurrentPR.FinalSignature, Converter={StaticResource ImageBytesConverter}}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentPR.FinalName}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="RFQPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="80" Width="80"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Request for Quotation (RFQ) - طلب عرض سعر" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Margin="0,0,0,20"/>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="RFQ Number / رقم طلب عرض السعر:" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentRFQ.RFQNumber}" Margin="5"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Closing Date / تاريخ الإغلاق:" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding CurrentRFQ.ClosingDate, StringFormat=d}" Margin="5"/>
                </Grid>

                <!-- Items -->
                <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedPR.Items}" AutoGenerateColumns="False" 
                          IsReadOnly="True" BorderThickness="1" BorderBrush="Black">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Description / الوصف" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Unit / الوحدة" Binding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="Quantity / الكمية" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Unit Price / سعر الوحدة" Width="100"/>
                        <DataGridTextColumn Header="Total / الإجمالي" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Terms -->
                <StackPanel Grid.Row="4" Margin="0,20,0,0">
                    <TextBlock Text="Terms &amp; Conditions / الشروط والأحكام:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentRFQ.Terms}" TextWrapping="Wrap" Margin="5"/>
                    
                    <Grid Margin="0,40,0,0">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         <StackPanel HorizontalAlignment="Center">
                             <TextBlock Text="Vendor Signature &amp; Stamp / توقيع وختم المورد" FontWeight="Bold"/>
                             <Border BorderBrush="Black" BorderThickness="1" Height="80" Width="200" Margin="10"/>
                         </StackPanel>
                         <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                             <TextBlock Text="Logistics Manager / مسؤول اللوجستيات" FontWeight="Bold"/>
                             <Border BorderBrush="Black" BorderThickness="1" Height="80" Width="200" Margin="10"/>
                         </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="BidAnalysisPrintTemplate">
        <Border Background="White" Width="1122" Height="793" Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="80" Width="80"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Analysis of RFQs" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentBidAnalysis.Date, StringFormat='Date: {0:d}'}"/>
                        <TextBlock Text="{Binding CurrentRFQ.RFQNumber, StringFormat='RFQ: {0}'}"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Margin="0,0,0,10"/>

                <Border Grid.Row="2" Background="#EEE" Margin="0,0,0,10" Padding="5">
                    <TextBlock Text="Justification For The Request" FontWeight="Bold" Foreground="#800000"/>
                </Border>

                <!-- Comparison Table (Matrix) -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Background="#EEE">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Description / Unit / Qty" FontWeight="Bold" Margin="5"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Bidders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="Black" BorderThickness="1,0,1,0" Width="100">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            
                            <ItemsControl ItemsSource="{Binding MatrixRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1">
                                                <StackPanel Margin="5">
                                                    <TextBlock Text="{Binding Description}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Unit, StringFormat='Unit: \{0\}'}" FontSize="10"/>
                                                    <TextBlock Text="{Binding Quantity, StringFormat='Qty: \{0\}'}" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding BidderPrices}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="Gray" BorderThickness="1" Width="100">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding UnitPrice, StringFormat=N2}" FontSize="10"/>
                                                                <TextBlock Text="{Binding TotalPrice, StringFormat=N2}" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Bidder Comparison Summary -->
                <Grid Grid.Row="4" Margin="0,10">
                    <ItemsControl ItemsSource="{Binding Bidders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" Margin="2" Width="150">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center" Background="#DDD"/>
                                        <Border Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Text="Subtotal:"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CalculatedSubTotal, StringFormat=N2}"/>
                                                
                                                <TextBlock Grid.Row="1" Text="Discount:"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Discount, StringFormat=N2}"/>
                                                
                                                <TextBlock Grid.Row="2" Text="Misc:"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MiscCosts, StringFormat=N2}"/>
                                                
                                                <TextBlock Grid.Row="3" Text="TOTAL:" FontWeight="Bold"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CalculatedTotal, StringFormat=N2}" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Signatures -->
                <UniformGrid Grid.Row="5" Columns="4" Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Checked By" FontWeight="Bold"/>
                        <TextBlock Text="Logistics Manager" FontSize="10"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="40" Width="150" Margin="5"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Reviewed By" FontWeight="Bold"/>
                        <TextBlock Text="Finance Manager" FontSize="10"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="40" Width="150" Margin="5"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Reviewed By" FontWeight="Bold"/>
                        <TextBlock Text="Project Manager" FontSize="10"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="40" Width="150" Margin="5"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Approved By" FontWeight="Bold"/>
                        <TextBlock Text="Head of Association" FontSize="10"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="40" Width="150" Margin="5"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="POPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo/Header -->
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- PO No / Clause / Date -->
                    <RowDefinition Height="Auto"/> <!-- Details Section -->
                    <RowDefinition Height="*"/>    <!-- Items Table -->
                    <RowDefinition Height="Auto"/> <!-- Terms Section -->
                    <RowDefinition Height="Auto"/> <!-- Signatures Section -->
                </Grid.RowDefinitions>

                <!-- 1. Logo and Header -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="60" Width="60"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="14" FontWeight="Bold" TextDecorations="Underline"/>
                        <TextBlock Text="Logistics Management" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Title -->
                <Border Grid.Row="1" Background="#1B4F72" Margin="0,0,0,10">
                    <TextBlock Text="PURCHASE ORDER" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
                </Border>

                <!-- 3. PO No / Clause / Date -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                        <TextBlock Text="PO NUMBER :" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentPO.PONumber}" FontSize="10"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="CLAUSE :" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="{Binding CurrentPO.Clause}" FontSize="10"/>
                    </Border>
                    <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5">
                        <TextBlock Text="DATE :" FontWeight="Bold"/>
                    </Border>
                    <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,1,1,1" Padding="5" Width="100">
                        <TextBlock Text="{Binding CurrentPO.Date, StringFormat=MM/dd/yyyy}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 4. Details Section (JAAHD vs VENDOR) -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- JAAHD Column -->
                    <Border BorderBrush="Black" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" Background="#922B21" Padding="5">
                                <TextBlock Text="DETAILS:" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="JAAHD" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="NAME :" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="Contact :" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.ContactInfo, Source={StaticResource Proxy}}" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="3" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="Tel. :" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5">
                                <TextBlock Text="" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="4" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="Email :" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5">
                                <TextBlock Text="" Foreground="Blue" TextDecorations="Underline" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="5" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="ADDRESS" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5">
                                <TextBlock Text="{Binding Data.Settings.Address, Source={StaticResource Proxy}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- VENDOR Column -->
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,1,1,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" Background="#AED6F1" Padding="5">
                                <TextBlock Text="VENDOR" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.Vendor.Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.Vendor.Contact}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.Vendor.Tel}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.Vendor.Email}" Foreground="Blue" TextDecorations="Underline" HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="0,1,1,0" Padding="5">
                                <TextBlock Text="{Binding CurrentPO.Vendor.Address}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. Items Table -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding CurrentPO.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="1" BorderBrush="Black" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#D5D8DC"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item الصنف" Binding="{Binding Description}" Width="100"/>
                            <DataGridTextColumn Header="Description المواصفات" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Unit الوحدة" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Quantity الكمية" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Unit Price سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Total Price إجمالي السعر" Binding="{Binding TotalPrice, StringFormat=N2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1,0,1,1" Background="#D5D8DC" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource TotalCost}" FontWeight="Bold" Margin="0,0,20,0"/>
                                <TextBlock Text="{Binding CurrentPO.TotalAmount, Converter={StaticResource CurrencyWordsConverter}, ConverterParameter='YER'}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Background="#D5D8DC" Padding="10">
                            <TextBlock Text="{Binding CurrentPO.TotalAmount, StringFormat=N2}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 6. Terms Section -->
                <Border Grid.Row="5" BorderBrush="Black" BorderThickness="1" Margin="0,10,0,10">
                    <StackPanel>
                        <Border Background="#D5D8DC" Padding="5">
                            <TextBlock Text="{DynamicResource SupplyTerms}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentPO.Terms}" TextWrapping="Wrap" Margin="10" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- 7. Signatures Section -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logistics -->
                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0" Padding="5">
                        <StackPanel>
                            <Border Background="#AED6F1" Margin="-5,-5,-5,5">
                                <TextBlock Text="{DynamicResource CheckedBy}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Position}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text=" : " FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource LogisticManager}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Name}" FontSize="10"/>
                                <TextBlock Text=" : " FontSize="10"/>
                                <TextBlock Text="{Binding CurrentPO.LogisticsName}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Date}" FontSize="10"/>
                                <TextBlock Text=" : " FontSize="10"/>
                                <TextBlock Text="{Binding CurrentPO.Date, StringFormat=d}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Signature}" FontSize="10" Margin="0,5,0,0"/>
                            <Image Source="{Binding CurrentPO.LogisticsSignature, Converter={StaticResource ImageBytesConverter}}" Height="40" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Finance -->
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0" Padding="5">
                        <StackPanel>
                            <Border Background="#D5D8DC" Margin="-5,-5,-5,5">
                                <TextBlock Text="{DynamicResource ReviewedBy}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Position}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text=" : " FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource FinanceManager}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Name}" FontSize="10"/>
                                <TextBlock Text=" : " FontSize="10"/>
                                <TextBlock Text="{Binding CurrentPO.FinanceName}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Date}" FontSize="10"/>
                                <TextBlock Text=" : " FontSize="10"/>
                                <TextBlock Text="{Binding CurrentPO.Date, StringFormat=d}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Signature}" FontSize="10" Margin="0,5,0,0"/>
                            <Image Source="{Binding CurrentPO.FinanceSignature, Converter={StaticResource ImageBytesConverter}}" Height="40" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- PM -->
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Padding="5">
                        <StackPanel>
                            <Border Background="#AED6F1" Margin="-5,-5,-5,5">
                                <TextBlock Text="{DynamicResource ApprovedBy}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Position}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text=" : " FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource ProjectManager}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Name}" FontSize="10"/>
                                <TextBlock Text=" : " FontSize="10"/>
                                <TextBlock Text="{Binding CurrentPO.PMName}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Date}" FontSize="10"/>
                                <TextBlock Text=" : " FontSize="10"/>
                                <TextBlock Text="{Binding CurrentPO.Date, StringFormat=d}" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Signature}" FontSize="10" Margin="0,5,0,0"/>
                            <Image Source="{Binding CurrentPO.PMSignature, Converter={StaticResource ImageBytesConverter}}" Height="40" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="GRNPrintTemplate">
        <Border Background="White" Width="793" Height="1122" Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Data.Settings.LogoImage, Source={StaticResource Proxy}, Converter={StaticResource ImageBytesConverter}}" Height="80" Width="80"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{Binding Data.Settings.AssociationName, Source={StaticResource Proxy}}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Goods Receiving Note" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Margin="0,0,0,20"/>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GRN Number:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentGRN.GRNNumber}" Margin="5"/>
                </Grid>

                <DataGrid Grid.Row="3" ItemsSource="{Binding GrnItems}" AutoGenerateColumns="False" 
                          IsReadOnly="True" BorderThickness="1" BorderBrush="Black">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedQuantity}" Width="80"/>
                        <DataGridTextColumn Header="Accepted" Binding="{Binding AcceptedQuantity}" Width="80"/>
                        <DataGridTextColumn Header="Rejected" Binding="{Binding RejectedQuantity}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <UniformGrid Grid.Row="4" Columns="2" Margin="0,40,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Storekeeper" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="120" Margin="5"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Receiver" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="120" Margin="5"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>
    </ControlTemplate>

</ResourceDictionary>
