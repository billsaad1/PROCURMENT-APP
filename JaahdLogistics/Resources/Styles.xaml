<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ProfessionalReportStyle" TargetType="Grid">
        <Setter Property="Background" Value="White"/>
    </Style>

    <ControlTemplate x:Key="PrintFormTemplate">
        <Border BorderBrush="Black" BorderThickness="1" Margin="20" Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Logo" Height="80" Width="80"/>
                    <TextBlock Grid.Column="1" Text="JAAHD ASSOCIATION" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="DocNumber" FontWeight="Bold"/>
                        <TextBlock x:Name="DocDate"/>
                    </StackPanel>
                </Grid>
                <Separator Margin="0,10"/>
                <ContentPresenter/>
            </StackPanel>
        </Border>
    </ControlTemplate>

</ResourceDictionary>
