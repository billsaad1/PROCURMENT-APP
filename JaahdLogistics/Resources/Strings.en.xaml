                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Login">Login</sys:String>
    <sys:String x:Key="Username">Username</sys:String>
    <sys:String x:Key="Password">Password</sys:String>
    <sys:String x:Key="PR">Purchase Requisition</sys:String>
    <sys:String x:Key="RFQ">Request for Quotation</sys:String>
    <sys:String x:Key="PO">Purchase Order</sys:String>
    <sys:String x:Key="Project">Project</sys:String>
    <sys:String x:Key="Budget">Budget</sys:String>
    <sys:String x:Key="Settings">Settings</sys:String>
